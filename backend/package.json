    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "supertest": "^6.3.4",
